# 环境变量说明
# 复制此文件为 .env 后修改对应配置

# 服务端口
PORT=8080
NODE_ENV=development

# 数据库
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tiaozhanbei

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# 国密 SM4 加密
SM4_KEY=your-32-char-sm4-key-here!!
SM4_IV=your-16-char-iv-here!

# AI 服务（云端验证阶段）
AI_API_BASE_URL=https://api.deepseek.com
AI_API_KEY=your-ai-api-key
AI_MODEL=deepseek-chat
AI_REVIEW_TIMEOUT_MS=90000
AI_DOCUMENT_TIMEOUT_MS=90000
AI_REPORT_TIMEOUT_MS=120000

# MinIO 对象存储
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tiaozhanbei

# Flowable 工作流
FLOWABLE_REST_URL=http://localhost:8081/flowable-rest
FLOWABLE_APP_KEY=workflow

# 跨域
CORS_ORIGIN=http://localhost:3000
